# Required for a real plan. Railway must set this. No secret belongs in git.
# The default model is OpenAI gpt-4.1-mini. Override with either variable.
# TRIP_PLANNER_MODEL accepts a provider-qualified name such as openai:gpt-4.1-mini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TRIP_PLANNER_MODEL=

# Dev and tests only. Do not set this on Railway.
TRIP_PLANNER_FAKE_LLM=0

# Required for web search. The tool reports an error when this is empty.
TAVILY_API_KEY=

# Required for restaurant and bar places. Either name works.
# The places server is skipped when both are empty.
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_API_KEY=

# MCP discovery timeout and retries. No API keys are required for Kiwi,
# lastminute.com, Skiplagged, OctoTrip, or Upfront Rentals.
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=3

# Optional LangSmith tracing. Not required for the local LangGraph server.
LANGSMITH_API_KEY=

# Port for `langgraph dev`. Railway sets this. Local default is 2024.
PORT=2024

# Browser origins allowed to call this API. Comma-separated. Do not use *.
# Local default (when unset) is the Next app on port 3000. On Railway set
# the UI service origin, for example https://trip-planner-ui.up.railway.app.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

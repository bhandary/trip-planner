# Hosted chat model. Railway production must set a real key.
# The default model is OpenAI gpt-5-nano. Override with either variable.
# TRIP_PLANNER_MODEL accepts a provider-qualified name such as openai:gpt-5-nano.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
TRIP_PLANNER_MODEL=

# Dev and tests only. Do not set this on Railway.
TRIP_PLANNER_FAKE_LLM=0

# Tavily web search for gaps the MCP servers do not cover.
TAVILY_API_KEY=

# Google Maps Grounding Lite (places) for the restaurant and bar agents.
# Either name works. The places server is skipped when both are empty.
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_API_KEY=

# MCP discovery timeout and retries. No API keys are required for Kiwi,
# lastminute.com, Skiplagged, OctoTrip, or Upfront Rentals.
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=3

# Optional LangSmith tracing. Not required for the local LangGraph server.
LANGSMITH_API_KEY=

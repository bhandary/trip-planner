# Copy to ui/.env for `pnpm dev`. These are public values. Do not put API keys here.
#
# NEXT_PUBLIC_* is inlined when Next.js builds (`pnpm build` or the Docker image).
# A running container does not read a new value. Changing the backend URL
# requires a new build. On Railway set this before the build:
#   NEXT_PUBLIC_API_URL=https://${{trip-planner.RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=trip_planner
NEXT_PUBLIC_AUTH_SCHEME=

# Optional same-origin proxy (src/app/api). The local and Railway setups in
# this repo point the browser at the LangGraph server directly, so these
# stay unused. The in-memory server does not need a LangSmith key.
LANGGRAPH_API_URL=http://localhost:2024
LANGSMITH_API_KEY=

# `pnpm start` and the Docker runner listen on 0.0.0.0 and this port.
# Railway sets PORT. Local default is 3000.
PORT=3000
